{
  "name": "web3auth-xrpl-example",
  "version": "0.1.0",
  "private": true,
  "description": "Web3Auth Modal SDK integration example with XRPL (XRP Ledger)",
  "license": "MIT",
  "author": "chicunic",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc6 --noEmit && vite build",
    "serve": "vite preview",
    "check": "tsc6 --noEmit && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@web3auth/modal": "^11.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
